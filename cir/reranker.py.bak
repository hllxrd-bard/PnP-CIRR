from __future__ import annotations

from dataclasses import dataclass
from typing import Any

import numpy as np

from .config import AppConfig
from .query_composer import ComposedQuery
from .utils import l2_normalize, normalize_rows


@dataclass
class RankedCandidate:
    entity: dict[str, Any]
    score: float
    component_scores: dict[str, float]
    matched_query: str | None
    matched_query_strength: float | None


class VectorReranker:
    def __init__(self, config: AppConfig):
        self.config = config
        self.cfg = config.section("reranking")
        self.fields = config.get("milvus.fields", {})
        self.epsilon = float(config.get("composition.epsilon", 1e-8))

    def rank(
        self,
        candidates: list[dict[str, Any]],
        reference_vector: np.ndarray,
        composed: ComposedQuery,
        negative_vectors: np.ndarray | None = None,
    ) -> list[RankedCandidate]:
        if not candidates:
            return []

        image_field = self.fields["image_vector"]
        text_field = self.fields["text_vector"]
        valid_candidates: list[dict[str, Any]] = []
        image_vectors: list[np.ndarray] = []
        text_vectors: list[np.ndarray | None] = []

        for entity in candidates:
            vector = entity.get(image_field)
            if vector is None:
                continue
            array = np.asarray(vector, dtype=np.float32).reshape(-1)
            if array.size == 0:
                continue
            valid_candidates.append(entity)
            image_vectors.append(array)
            text_value = entity.get(text_field)
            text_vectors.append(
                np.asarray(text_value, dtype=np.float32).reshape(-1)
                if text_value is not None
                else None
            )

        if not valid_candidates:
            return []

        image_matrix = normalize_rows(np.stack(image_vectors, axis=0), self.epsilon)
        reference = l2_normalize(reference_vector, self.epsilon)
        target = composed.target_vector
        direction = composed.direction_vector

        query_matrix = normalize_rows(
            np.stack([item.vector for item in composed.named_queries], axis=0), self.epsilon
        )
        composed_scores_all = image_matrix @ query_matrix.T
        best_query_indices = np.argmax(composed_scores_all, axis=1)
        composed_scores = composed_scores_all[np.arange(len(valid_candidates)), best_query_indices]
        target_scores = image_matrix @ target
        keep_scores = image_matrix @ reference

        candidate_directions = normalize_rows(image_matrix - reference[None, :], self.epsilon)
        direction_scores = candidate_directions @ direction

        metadata_scores = np.zeros(len(valid_candidates), dtype=np.float32)
        valid_text_indices: list[int] = []
        valid_text_vectors: list[np.ndarray] = []
        for index, vector in enumerate(text_vectors):
            if vector is not None and vector.size == target.size:
                valid_text_indices.append(index)
                valid_text_vectors.append(vector)
        if valid_text_vectors:
            text_matrix = normalize_rows(np.stack(valid_text_vectors, axis=0), self.epsilon)
            metadata_scores[np.asarray(valid_text_indices)] = text_matrix @ target

        negative_penalties = np.zeros(len(valid_candidates), dtype=np.float32)
        if negative_vectors is not None and len(negative_vectors) > 0:
            negative_matrix = normalize_rows(negative_vectors, self.epsilon)
            negative_penalties = np.maximum(image_matrix @ negative_matrix.T, 0.0).max(axis=1)

        weights = self.cfg.get("weights", {})
        final_scores = (
            float(weights.get("composed", 0.30)) * composed_scores
            + float(weights.get("target", 0.22)) * target_scores
            + float(weights.get("reference_keep", 0.20)) * keep_scores
            + float(weights.get("direction", 0.18)) * direction_scores
            + float(weights.get("metadata", 0.10)) * metadata_scores
            - float(self.cfg.get("negative_penalty_weight", 0.20)) * negative_penalties
        )

        ranked: list[RankedCandidate] = []
        for index, entity in enumerate(valid_candidates):
            query_item = composed.named_queries[int(best_query_indices[index])]
            ranked.append(
                RankedCandidate(
                    entity=entity,
                    score=float(final_scores[index]),
                    component_scores={
                        "composed": float(composed_scores[index]),
                        "target": float(target_scores[index]),
                        "reference_keep": float(keep_scores[index]),
                        "direction": float(direction_scores[index]),
                        "metadata": float(metadata_scores[index]),
                        "negative_penalty": float(negative_penalties[index]),
                    },
                    matched_query=query_item.name,
                    matched_query_strength=query_item.strength,
                )
            )
        ranked.sort(key=lambda item: item.score, reverse=True)
        return ranked
